{
  "name": "axon",
  "productName": "Axon",
  "version": "2.0.0",
  "private": true,
  "description": "Локальный редактор схем и заметок Axon",
  "author": "Axon",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit \u0026\u0026 vite build \u0026\u0026 node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:desktop": "node tests/desktop.mjs",
    "package:win": "npm run dist:win",
    "dist:win": "node scripts/publish-windows.mjs",
    "dist:mac": "npm run build \u0026\u0026 electron-builder --mac dmg zip",
    "test:recovery": "node tests/recovery.mjs",
    "test:exports": "node tests/verify-exports.mjs",
    "test:interactions": "node tests/interactions.mjs",
    "setup:electron": "node node_modules/electron/install.js",
    "format": "prettier --write src electron tests scripts docs *.json *.ts *.js README.md"
  },
  "build": {
    "appId": "app.axon.desktop",
    "productName": "Axon",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!**/{test,tests,__tests__}{,/**/*}"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "axon",
        "name": "Документ Axon",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "Axon"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.48.0",
    "opentype.js": "1.3.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.3",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
